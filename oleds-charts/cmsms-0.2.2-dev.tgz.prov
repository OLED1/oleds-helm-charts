Hash: SHA512

annotations:
  artifacthub.io/changes: |
    - kind: security
      description: Fixed PHP2Shell (CVE-2026-109618, CVE-2026-109619) — image now requires Sury php7.4 >= 1:7.4.33-31, which backports the fix from PHP 8.2.35. The package changelog is kept in the image as evidence.
      links:
        - name: CVE-2026-109618
          url: https://nvd.nist.gov/vuln/detail/CVE-2026-109618
        - name: CVE-2026-109619
          url: https://nvd.nist.gov/vuln/detail/CVE-2026-109619
    - kind: security
      description: Disabled PHP session upload progress and pinned it via php_admin_flag so .htaccess cannot re-enable it — defense in depth for CVE-2026-109619 and mitigation for the not yet patched CVE-2026-115560.
      links:
        - name: CVE-2026-115560
          url: https://nvd.nist.gov/vuln/detail/CVE-2026-115560
    - kind: security
      description: Fixed blueimp-file-upload CVE-2018-9206 — the vulnerable server handler is not shipped (FileManager uses its own upload handling), client scripts updated to 9.22.1, HTTP access to the handler path denied as a safeguard.
      links:
        - name: CVE-2018-9206
          url: https://nvd.nist.gov/vuln/detail/CVE-2018-9206
    - kind: fixed
      description: Redirects such as /admin → /admin/ now use the public URL from cmsms_settings.host instead of http://<host>:8080.
    - kind: fixed
      description: cmsms_app.strategy.type Recreate no longer fails with "rollingUpdate may not be specified".
    - kind: fixed
      description: Fallback to older database configuration when available.
  artifacthub.io/containsSecurityUpdates: "true"
